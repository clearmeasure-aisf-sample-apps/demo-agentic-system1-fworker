#!/usr/bin/env bash
# git-credential-fworker: the git credential helper of the fwrunner image (docs/design/cloud-worker-runtimes.md, section 2.6).
# The container holds no GitHub credential of its own. For github.com it asks the gateway's verb git-credential, with the item token (i1)
# of the item the session owns, for a one-hour installation token scoped to the work-orders repository, and hands it to git.
#
# Contract (design 2.6; the verb is built in the gateway separately):
#   POST $FACTORY_URL/api/v1/verbs/git-credential   Authorization: Bearer <i1 of role owner>   body {"item": N}
#   200 {"ok":true,"token":"ghs_...","expires_at":"<ISO-8601>"}     403 when the i1 is not an owner token or not for that item
# The item is FWRUNNER_ITEM, else the item number the client keeps in <FWRUNNER_HOME>/session-owning; the i1 is
# <FACTORY_DATA_DIR>/tokens/<item>.owner, saved by the client at item.assigned. The answer is cached in a private file until 5 minutes
# before it expires. Only `get` does anything; `store` and `erase` are ignored (the gateway owns the token's lifetime), except that `erase`
# drops the cache, which git calls after the token was refused.
set -u
op=${1:-}
home=${FWRUNNER_HOME:-/work}
cache="${FACTORY_DATA_DIR:-$home/data}/.git-credential.cache"

declare -A in
while IFS='=' read -r k v; do [ -n "$k" ] || break; in[$k]=$v; done
[ "${in[protocol]:-}" = https ] && [ "${in[host]:-}" = github.com ] || exit 0

case "$op" in
    erase) rm -f "$cache"; exit 0 ;;
    get) ;;
    *) exit 0 ;;
esac

json() { node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{const v=JSON.parse(s)[process.argv[1]];process.stdout.write(v==null?"":String(v))}catch{}})' "$1"; }
emit() { printf 'username=x-access-token\npassword=%s\n' "$1"; exit 0; }

now=$(date +%s)
if [ -s "$cache" ]; then
    read -r exp tok < "$cache"
    if [ -n "${tok:-}" ] && [ "${exp:-0}" -gt $((now + 300)) ] 2>/dev/null; then emit "$tok"; fi
fi

[ -n "${FACTORY_URL:-}" ] || { echo "git-credential-fworker: FACTORY_URL is not set" >&2; exit 0; }
item=${FWRUNNER_ITEM:-}
[ -n "$item" ] || item=$(tr -dc '0-9' < "$home/session-owning" 2>/dev/null)
[[ "$item" =~ ^[0-9]*$ ]] || { echo "git-credential-fworker: FWRUNNER_ITEM is not a number" >&2; exit 0; }
[ -n "$item" ] || { echo "git-credential-fworker: no item is owned yet, so there is no push credential" >&2; exit 0; }
i1file="${FACTORY_DATA_DIR:-$home/data}/tokens/$item.owner"
[ -s "$i1file" ] || { echo "git-credential-fworker: no owner token for item $item" >&2; exit 0; }

resp=$(curl -sS --max-time 30 -X POST -H 'Content-Type: application/json' -H @<(printf 'Authorization: Bearer %s\n' "$(tr -d '\r\n' < "$i1file")") \
    --data-binary "{\"item\":$item}" -w '\n%{http_code}' "${FACTORY_URL%/}/api/v1/verbs/git-credential") || { echo "git-credential-fworker: the gateway did not answer" >&2; exit 0; }
code=${resp##*$'\n'}; resp=${resp%$'\n'*}
if [ "$code" != 200 ]; then echo "git-credential-fworker: git-credential refused (HTTP $code $(printf '%s' "$resp" | json code))" >&2; exit 0; fi
tok=$(printf '%s' "$resp" | json token)
[ -n "$tok" ] || { echo "git-credential-fworker: no token in the answer" >&2; exit 0; }
expAt=$(printf '%s' "$resp" | json expires_at)
exp=$((now + 3000)); [ -z "$expAt" ] || exp=$(date -d "$expAt" +%s 2>/dev/null) || exp=$((now + 3000))
(umask 077; mkdir -p "$(dirname "$cache")"; printf '%s %s\n' "$exp" "$tok" > "$cache")
emit "$tok"
