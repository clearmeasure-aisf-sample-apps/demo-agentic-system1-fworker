{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(pwsh /work/plugin/scripts/factory.ps1 *)",
      "Bash(pwsh -NoProfile -File /work/plugin/scripts/factory.ps1 *)",
      "Bash(pwsh /work/plugin/scripts/*.ps1 *)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet run *)",
      "Bash(dotnet restore *)",
      "Bash(pwsh ./build.ps1 *)",
      "Bash(pwsh -NoProfile -File ./build.ps1 *)",
      "Bash(pwsh -NoProfile -Command . ./build.ps1*)",
      "Bash(git worktree remove /work/*)",
      "Bash(git worktree prune*)",
      "Bash(rm -rf /work/*)",
      "Bash(npx playwright test*)",
      "Bash(sqlite3 *)",
      "Bash(tail *)",
      "Read(//work/**)",
      "Edit(//work/**)",
      "Read(//tmp/**)",
      "Edit(//tmp/**)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.nuget.org)"
    ],
    "deny": [
      "Read(//etc/fworker/**)",
      "Edit(//etc/**)",
      "Edit(//usr/**)",
      "Edit(//opt/**)",
      "Edit(//home/**)",
      "Edit(//root/**)",
      "Edit(//ms-playwright/**)",
      "Read(//proc/*/environ)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(cat /proc/*/environ*)",
      "Bash(cat /etc/fworker/*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push * master*)",
      "Bash(git push * HEAD:master*)",
      "Bash(git push * main*)",
      "Bash(git push *:master*)",
      "Bash(git push *:main*)",
      "Bash(git push *refs/heads/master*)",
      "Bash(git push *refs/heads/main*)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(scp *)",
      "Bash(ssh *)",
      "Bash(sudo *)"
    ]
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1"
  }
}
